+     if method=='RM_top10':
+      d=x['mean_delta'];lines.append(f"|{arm}|{gen}|{base}|{d[METRICS[0]]:+.6f}|{d[METRICS[1]]:+.6f}|{d[METRICS[2]]:+.6f}|{x['joint_quality_improvement_fraction']:.1%}|")
