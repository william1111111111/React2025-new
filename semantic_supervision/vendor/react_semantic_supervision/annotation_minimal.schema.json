{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "REACT evidence annotation minimal sidecar v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "split",
    "clip_id",
    "duration_s",
    "is_synthetic_example",
    "allowed_for_model_input",
    "visible_roles",
    "annotator_version",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "react-label-v0.1"
    },
    "record_type": {
      "enum": [
        "speaker_events",
        "listener_observations",
        "event_links"
      ]
    },
    "split": {
      "enum": [
        "train",
        "val",
        "test"
      ]
    },
    "clip_id": {
      "type": "string",
      "minLength": 1
    },
    "duration_s": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "is_synthetic_example": {
      "type": "boolean"
    },
    "allowed_for_model_input": {
      "type": "boolean"
    },
    "visible_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "speaker",
          "listener"
        ]
      }
    },
    "annotator_version": {
      "type": "string",
      "minLength": 1
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "start_s",
          "end_s",
          "description",
          "evidence_status",
          "evidence_ref"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "minLength": 1
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "minimum": 0
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence_status": {
            "enum": [
              "supported",
              "ambiguous",
              "unobserved"
            ]
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "event_type": {
            "type": "string"
          },
          "transcript_evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "response_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "link_status": {
            "enum": [
              "temporal_association",
              "unknown"
            ]
          },
          "record_A_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "record_B_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "match_status": {
            "enum": [
              "supported",
              "ambiguous",
              "unmatched"
            ]
          }
        }
      }
    }
  }
}